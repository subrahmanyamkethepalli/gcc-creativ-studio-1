gcp_project_id = "sbd-ai-poc-h"
gcp_region     = "us-central1"
environment    = "development"

vpc_id = "proj-sbd-ai-poc-h-sopke-vnet"
subnet_id = "proj-sbd-ai-poc-h-sopke-vnet-subnet"

# --- Private Application URL ---


# Waiting for DNS team
internal_app_url = "sbd-poc.com"

# Waiting for Network/IPAM team
proxy_only_subnet_cidr = ""

# Waiting for Security/Certificate team
ssl_certificate_id = "<APPROVED_REGIONAL_CERTIFICATE_ID>"


# --- Service Names ---
backend_service_name = "cstudio-be"
frontend_service_name = "cstudio-fe"


# --- GitHub Repo Details ---
github_conn_name = "creative-studio-github-gcc"
github_repo_owner = "subrahmanyam-kethe_hcl"
github_repo_name = "gcc-creative-studio"
github_branch_name = "master"



cloud_run_sa = "gcc-creative-studio-dev-sa@sbd-ai-poc-h.iam.gserviceaccount.com"

cloudbuild_sa = "gcc-creative-studio-build@sbd-ai-poc-h.iam.gserviceaccount.com"

cloudbuild_sa_id = "projects/sbd-ai-poc-h/serviceAccounts/gcc-creative-studio-build@sbd-ai-poc-h.iam.gserviceaccount.com"


# --- Custom Audiences ---
backend_custom_audiences = [
  "393352738141-rp3afduv41ml1o6dre2gk0ecpgj9q1pr.apps.googleusercontent.com",
  "sbd-ai-poc-h"
]

frontend_custom_audiences = [
  "393352738141-rp3afduv41ml1o6dre2gk0ecpgj9q1pr.apps.googleusercontent.com",
  "sbd-ai-poc-h"
]

# --- Service-Specific Environment Variables ---

be_env_vars = {
  common = {
    LOG_LEVEL = "INFO"
  }

  development = {
    ENVIRONMENT                    = "development"
    GOOGLE_TOKEN_AUDIENCE          = "393352738141-rp3afduv41ml1o6dre2gk0ecpgj9q1pr.apps.googleusercontent.com"
    IDENTITY_PLATFORM_ALLOWED_ORGS = ""
  }

  production = {
    ENVIRONMENT                    = "production"
    GOOGLE_TOKEN_AUDIENCE          = "393352738141-rp3afduv41ml1o6dre2gk0ecpgj9q1pr.apps.googleusercontent.com"
    IDENTITY_PLATFORM_ALLOWED_ORGS = ""
  }
}



fe_build_substitutions = {
  _ANGULAR_BUILD_COMMAND = "build-dev"
}

frontend_secrets = [
  "FIREBASE_API_KEY",          # Your Firebase Web API Key
  "FIREBASE_AUTH_DOMAIN",      # Your Firebase Auth Domain (e.g., project-id.firebaseapp.com)
  "FIREBASE_PROJECT_ID",       # Your Firebase Project ID
  "FIREBASE_STORAGE_BUCKET",   # Your Firebase Storage Bucket (e.g., project-id.appspot.com)
  "FIREBASE_MESSAGING_SENDER_ID", # Your Firebase Cloud Messaging Sender ID
  "FIREBASE_APP_ID",           # Your Firebase Web App ID
  "FIREBASE_MEASUREMENT_ID",   # Your Google Analytics Measurement ID
  "GOOGLE_CLIENT_ID",          # Your Google OAuth 2.0 Client ID for web
]

backend_secrets = [
  "GOOGLE_TOKEN_AUDIENCE",
]

backend_runtime_secrets = {
  "GOOGLE_TOKEN_AUDIENCE" = "GOOGLE_TOKEN_AUDIENCE"
}

apis_to_enable = [
  "serviceusage.googleapis.com",
  "iam.googleapis.com",
  "cloudbuild.googleapis.com",
  "artifactregistry.googleapis.com",
  "run.googleapis.com",
  "cloudresourcemanager.googleapis.com",
  "compute.googleapis.com",
  "cloudfunctions.googleapis.com",
  "iamcredentials.googleapis.com",
  "aiplatform.googleapis.com",
  "firestore.googleapis.com",
  "texttospeech.googleapis.com",
  "workflows.googleapis.com",

  # Required by Creative Studio
  "secretmanager.googleapis.com",
  "sqladmin.googleapis.com",
  "firebase.googleapis.com",
  "identitytoolkit.googleapis.com",
]
